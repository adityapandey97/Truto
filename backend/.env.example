# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=development_jwt_secret_key_needs_to_be_at_least_32_chars_long
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database Configuration
# Supports local MongoDB daemon or MongoDB Atlas URL.
# If connection fails in development, auto-falls back to embedded in-memory database.
MONGODB_URI=mongodb://localhost:27017/codepilot
