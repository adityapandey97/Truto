# ==========================================
# CodePilot AI Service — Environment Variables
# ==========================================

# Server & Network
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# Internal Service-to-Service Authentication Key
INTERNAL_SERVICE_KEY=dev-internal-service-secret-key-32chars-min

# PostgreSQL & pgvector Configuration
POSTGRES_URI=postgresql://postgres:postgres@localhost:5432/codepilot_vectors
ENABLE_PGVECTOR=false
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# LLM Provider Configuration (mock | openai | anthropic | ollama)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_REQUEST_TIMEOUT=45

# Embedding Configuration (mock | sentence_transformers | openai)
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# Codebase Indexing & Limits
MAX_REPO_FILE_SIZE_BYTES=1048576
MAX_TOTAL_REPO_BYTES=52428800
MAX_CHUNK_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

# Agent Orchestrator & Sandbox Verification
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=12
VERIFICATION_TIMEOUT_SECONDS=30
SANDBOX_MEMORY_LIMIT=512m
